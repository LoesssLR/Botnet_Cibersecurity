# ============================================================
# Plantilla de configuracion. Copiar a .env y completar valores.
# El archivo .env nunca se sube al repositorio.
# ============================================================

# --- Servidor botnet (C2) ---
C2_BIND_HOST=0.0.0.0
C2_PORT=8443
# Opcional: si se define, el agente/.exe debe enviar el mismo valor en "hello"
C2_SHARED_SECRET=

# --- Servidor victima (objetivo de las pruebas) ---
# Opcional: si se define, solo se permite ese host como target de load
# (127.0.0.1, localhost y ::1 quedan permitidos para pruebas locales).
# Dejar vacio para permitir cualquier host http:// en el laboratorio.
TARGET_HOST=
# Si el target no especifica puerto, se aplica este; si especifica otro,
# se rechaza (salvo en hosts locales de prueba). Dejar vacio para no fijarlo.
TARGET_HTTP_PORT=80
# API de Netdata del servidor victima, puerto 19999
# (IP privada si esta en el mismo VPC, o elastica si esta en otra cuenta)
NETDATA_URL=http://IP_PRIVADA_VICTIMA:19999

# --- Rutas de trabajo ---
LOG_DIR=logs
DATA_DIR=data
