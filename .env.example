# ============================================================
# Plantilla de configuracion. Copiar a .env y completar valores.
# El archivo .env nunca se sube al repositorio.
# ============================================================

# --- Servidor botnet (C2) ---
C2_BIND_HOST=0.0.0.0
C2_PORT=8443
C2_SHARED_SECRET=cambiar-por-un-secreto-largo

# --- Servidor victima (objetivo de las pruebas) ---
TARGET_HOST=203.0.113.10
TARGET_HTTP_PORT=80
# API de Netdata del servidor victima (IP elastica, puerto 19999)
NETDATA_URL=http://IP_ELASTICA_VICTIMA:19999

# --- Rutas de trabajo ---
LOG_DIR=logs
DATA_DIR=data
